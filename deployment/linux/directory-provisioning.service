[Unit]
Description=Directory Provisioning Service
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=dps
Group=dps
WorkingDirectory=/opt/directory-provisioning-service
EnvironmentFile=/etc/directory-provisioning-service/secrets.env
ExecStart=/usr/bin/java -jar /opt/directory-provisioning-service/quarkus-app/quarkus-run.jar
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/directory-provisioning-service/logs

[Install]
WantedBy=multi-user.target
